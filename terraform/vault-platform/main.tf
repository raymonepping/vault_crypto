terraform {
  required_version = ">= 1.5.0"
  required_providers {
    vault = {
      source  = "hashicorp/vault"
      version = "~> 5.13"
    }
  }
  backend "local" {
    path = "../../.secrets/terraform/vault-platform.tfstate"
  }
}

# vault-1 ENT, with its root token: exported by scripts/tf.sh.
provider "vault" {}

variable "network_cidr" {
  description = "Subnet of vcry-internal; AppRole identities may only log in from it"
  type        = string
}

variable "app_secret_id_ttl" {
  description = "Lifetime of the app-plane secret-ids in seconds (rotated at 1/3 life)"
  type        = number
  default     = 7776000 # 90 days
}

# ── AppRole mount (tuned to allow 90-day secret-ids) ─────────────────────────
resource "vault_auth_backend" "approle" {
  type        = "approle"
  path        = "approle"
  description = "App-plane machine identities (rotator, API agent, web TLS agent)"
  tune {
    default_lease_ttl = "1h"
    max_lease_ttl     = "2160h"
  }
}

# ── cryptolab-api: the API, through vault-agent's token sink ─────────────────
# Does what the four rooms show; never issues from `web` (the UI's own
# certificate belongs to tls-agent) and never exports a CA key.
resource "vault_policy" "cryptolab_api" {
  name   = "cryptolab-api"
  policy = file("${path.module}/../../vault/policies/cryptolab-api.hcl")
}

resource "vault_approle_auth_backend_role" "cryptolab_api" {
  backend               = vault_auth_backend.approle.path
  role_name             = "cryptolab-api"
  token_policies        = ["default", vault_policy.cryptolab_api.name]
  token_ttl             = 900
  token_max_ttl         = 3600
  secret_id_ttl         = var.app_secret_id_ttl
  token_bound_cidrs     = [var.network_cidr]
  secret_id_bound_cidrs = [var.network_cidr]
}

# ── web-tls: tls-agent renders the web server's certificate ──────────────────
resource "vault_policy" "web_tls" {
  name   = "web-tls"
  policy = file("${path.module}/../../vault/policies/web-tls.hcl")
}

resource "vault_approle_auth_backend_role" "web_tls" {
  backend               = vault_auth_backend.approle.path
  role_name             = "web-tls"
  token_policies        = ["default", vault_policy.web_tls.name]
  token_ttl             = 900
  token_max_ttl         = 3600
  secret_id_ttl         = var.app_secret_id_ttl
  token_bound_cidrs     = [var.network_cidr]
  secret_id_bound_cidrs = [var.network_cidr]
}

# ── Rotator identity (the one handed-over credential on this plane) ──────────
locals {
  rotated_roles = [
    vault_approle_auth_backend_role.cryptolab_api.role_name,
    vault_approle_auth_backend_role.web_tls.role_name,
  ]
}

resource "vault_policy" "crypto_rotator" {
  name = "crypto-rotator"
  policy = join("\n", [for r in local.rotated_roles : <<-EOT
    path "auth/approle/role/${r}/role-id" {
      capabilities = ["read"]
    }
    path "auth/approle/role/${r}/secret-id" {
      capabilities = ["create", "update"]
    }
    path "auth/approle/role/${r}/secret-id/lookup" {
      capabilities = ["create", "update"]
    }
    path "auth/approle/role/${r}/secret-id-accessor/destroy" {
      capabilities = ["create", "update"]
    }
  EOT
  ])
}

resource "vault_approle_auth_backend_role" "crypto_rotator" {
  backend               = vault_auth_backend.approle.path
  role_name             = "crypto-rotator"
  token_policies        = [vault_policy.crypto_rotator.name]
  token_ttl             = 300
  token_max_ttl         = 600
  secret_id_ttl         = 0
  token_bound_cidrs     = [var.network_cidr]
  secret_id_bound_cidrs = [var.network_cidr]
}

output "rotated_roles" {
  value = local.rotated_roles
}

# ── Identity secrets (prompt 08) ──────────────────────────────────────────────
# Every identity password (LDAP admin, Keycloak admin, the console's client
# secret, one per persona) lives here, generated by scripts/identity-secrets.sh.
resource "vault_mount" "kv" {
  path        = "kv"
  type        = "kv"
  options     = { version = "2" }
  description = "Lab secrets: identity stack passwords (kv/vcry/identity/*)"
}

resource "vault_policy" "identity_secrets" {
  name   = "identity-secrets"
  policy = <<-EOT
    # One-shot identity-secrets-init: read the identity stack's secrets, nothing else.
    path "kv/data/vcry/identity/*" {
      capabilities = ["read"]
    }
    path "kv/metadata/vcry/identity/users" {
      capabilities = ["list"]
    }
  EOT
}

resource "vault_approle_auth_backend_role" "identity_secrets" {
  backend               = vault_auth_backend.approle.path
  role_name             = "identity-secrets"
  token_policies        = [vault_policy.identity_secrets.name]
  token_ttl             = 120
  token_max_ttl         = 300
  secret_id_ttl         = 0
  token_bound_cidrs     = [var.network_cidr]
  secret_id_bound_cidrs = [var.network_cidr]
}
